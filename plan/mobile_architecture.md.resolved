### 3.2 Package Manager: Swift Package Manager (SPM)

Xcode → File → Add Package Dependencies:
- `https://github.com/socketio/socket.io-client-swift`
- `https://github.com/AgoraIO/AgoraRtcEngine_iOS`

### 3.3 ViewModel (ObservableObject)

```swift
@MainActor
final class PersonalRoomViewModel: ObservableObject {
    @Published var isCameraOn: Bool = false
    @Published var isLoading: Bool = false
    @Published var errorMessage: String?

    private let getRoomUseCase: GetPersonalRoomUseCase
    private let agoraManager: AgoraManager

    init(getRoomUseCase: GetPersonalRoomUseCase, agoraManager: AgoraManager) {
        self.getRoomUseCase = getRoomUseCase
        self.agoraManager = agoraManager
    }

    func toggleCamera() async {
        if isCameraOn {
            await agoraManager.leaveChannel()
        } else {
            do {
                let token = try await getRoomUseCase.getAgoraToken()
                await agoraManager.joinChannel(token: token)
            } catch {
                errorMessage = error.localizedDescription
                return
            }
        }
        isCameraOn.toggle()
    }
}
```

### 3.4 SwiftUI View

```swift
struct PersonalRoomView: View {
    @StateObject private var viewModel = PersonalRoomViewModel(
        getRoomUseCase: AppDependencies.shared.getRoomUseCase,
        agoraManager: AppDependencies.shared.agoraManager
    )

    var body: some View {
        VStack(spacing: 16) {
            if viewModel.isCameraOn {
                AgoraLocalVideoView(agoraManager: viewModel.agoraManager)
                    .frame(maxWidth: .infinity, minHeight: 300)
                    .cornerRadius(16)
            }

            Button(action: {
                Task { await viewModel.toggleCamera() }
            }) {
                Label(
                    viewModel.isCameraOn ? "Kamerayı Kapat" : "Kamerayı Aç",
                    systemImage: viewModel.isCameraOn ? "video.slash" : "video"
                )
                .frame(maxWidth: .infinity)
                .padding()
                .background(viewModel.isCameraOn ? Color.red : Color.blue)
                .foregroundColor(.white)
                .cornerRadius(12)
            }
        }
        .padding()
    }
}
```

---

## 4. Kamera — Profesyonel Yaklaşım (Agora RTC)

### 4.1 Neden Agora?

Agora, SFU (Selective Forwarding Unit) mimarisi kullanan profesyonel medya sunucusudur.

```
SFU Mimarisi (Agora):
Kullanıcı A → [Agora Sunucusu] → Kullanıcı B, C, D
                                 (herkese Agora dağıtır)

Ham WebRTC P2P:
Kullanıcı A ←→ Kullanıcı B
      ↕              ↕
Kullanıcı C ←→ Kullanıcı D  ← 4 kişide 6 bağlantı, 10 kişide 45!
```

SFU'da her kullanıcı sadece 1 bağlantı açar → Ölçeklenebilir.

### 4.2 Token Akışı (Güvenlik)

```
1. Kullanıcı "Kamerayı Aç"a basar
2. App → GET /rooms/{id}/agora-token  (Backend'e istek)
3. NestJS → Agora App Certificate ile token üretir
4. Token → App'e döner (1 saat geçerli)
5. App → Agora SDK'ya token ile join olur
6. Kamera akışı başlar
```

> App Certificate'ı mobil uygulamaya gömmek GÜVENSİZDİR.
> Biri APK/IPA'yı decompile edip sınırsız oda açabilir.
> Token her zaman backend'den üretilmelidir.

### 4.3 Android — Agora AgoraManager

```kotlin
// AgoraManager.kt
@Singleton
class AgoraManager @Inject constructor(
    @ApplicationContext private val context: Context
) {
    private var rtcEngine: RtcEngine? = null

    fun initialize(appId: String) {
        val config = RtcEngineConfig().apply {
            mContext = context
            mAppId = appId
            mEventHandler = object : IRtcEngineEventHandler() {
                override fun onUserJoined(uid: Int, elapsed: Int) {
                    // Başka kullanıcı odaya girdi — UI güncelle
                }
                override fun onUserOffline(uid: Int, reason: Int) {
                    // Kullanıcı ayrıldı — UI güncelle
                }
            }
        }
        rtcEngine = RtcEngine.create(config)
        rtcEngine?.enableVideo()
    }

    fun joinChannel(token: String, channelId: String) {
        val options = ChannelMediaOptions().apply {
            publishCameraTrack = true
            publishMicrophoneTrack = false   // MVP: sadece görüntü
            clientRoleType = CLIENT_ROLE_BROADCASTER
        }
        rtcEngine?.joinChannel(token, channelId, 0, options)
    }

    fun setupLocalVideo(surfaceView: SurfaceView) {
        rtcEngine?.setupLocalVideo(VideoCanvas(surfaceView, RENDER_MODE_HIDDEN, 0))
        rtcEngine?.startPreview()
    }

    fun leaveChannel() {
        rtcEngine?.leaveChannel()
    }
}

// Compose'da kullanım
@Composable
fun AgoraLocalVideoView(agoraManager: AgoraManager) {
    AndroidView(
        factory = { ctx ->
            SurfaceView(ctx).also { view ->
                agoraManager.setupLocalVideo(view)
            }
        },
        modifier = Modifier.fillMaxSize()
    )
}
```

### 4.4 iOS — Agora AgoraManager

```swift
// AgoraManager.swift
import AgoraRtcKit

@MainActor
final class AgoraManager: NSObject, ObservableObject {
    private var agoraKit: AgoraRtcEngineKit?
    @Published var remoteUserIds: [UInt] = []

    func initialize(appId: String) {
        let config = AgoraRtcEngineConfig()
        config.appId = appId
        agoraKit = AgoraRtcEngineKit.sharedEngine(with: config, delegate: self)
        agoraKit?.enableVideo()
    }

    func joinChannel(token: String, channelId: String) async {
        let options = AgoraRtcChannelMediaOptions()
        options.publishCameraTrack = true
        options.publishMicrophoneTrack = false
        options.clientRoleType = .broadcaster
        agoraKit?.joinChannel(byToken: token, channelId: channelId, uid: 0, mediaOptions: options)
    }

    func setupLocalVideo(view: UIView) {
        let canvas = AgoraRtcVideoCanvas()
        canvas.view = view
        canvas.renderMode = .hidden
        canvas.uid = 0
        agoraKit?.setupLocalVideo(canvas)
        agoraKit?.startPreview()
    }

    func leaveChannel() {
        agoraKit?.leaveChannel()
    }
}

extension AgoraManager: AgoraRtcEngineDelegate {
    func rtcEngine(_ engine: AgoraRtcEngineKit, didJoinedOfUid uid: UInt, elapsed: Int) {
        remoteUserIds.append(uid)
    }
    func rtcEngine(_ engine: AgoraRtcEngineKit, didOfflineOfUid uid: UInt, reason: AgoraUserOfflineReason) {
        remoteUserIds.removeAll { $0 == uid }
    }
}

// UIViewRepresentable — SwiftUI içine UIKit view
struct AgoraLocalVideoView: UIViewRepresentable {
    let agoraManager: AgoraManager

    func makeUIView(context: Context) -> UIView {
        let view = UIView()
        agoraManager.setupLocalVideo(view: view)
        return view
    }
    func updateUIView(_ uiView: UIView, context: Context) {}
}
```

### 4.5 İzin Yönetimi

**Android — AndroidManifest.xml:**
```xml
<uses-permission android:name="android.permission.CAMERA" />
<uses-permission android:name="android.permission.RECORD_AUDIO" />
<uses-permission android:name="android.permission.INTERNET" />
```

```kotlin
// Compose runtime izin
val cameraPermission = rememberPermissionState(Manifest.permission.CAMERA)

if (cameraPermission.status.isGranted) {
    AgoraLocalVideoView(agoraManager)
} else {
    Button(onClick = { cameraPermission.launchPermissionRequest() }) {
        Text("Kamera İznini Ver")
    }
}
```

**iOS — Info.plist:**
```xml
<key>NSCameraUsageDescription</key>
<string>Çalışma odanızda kameranızı kullanmak için erişim gereklidir.</string>
```

```swift
// Swift izin kontrolü
import AVFoundation

func requestCameraPermission() async -> Bool {
    switch AVCaptureDevice.authorizationStatus(for: .video) {
    case .authorized: return true
    case .notDetermined:
        return await AVCaptureDevice.requestAccess(for: .video)
    default: return false
    }
}
```

