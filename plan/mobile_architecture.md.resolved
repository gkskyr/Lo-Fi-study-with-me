## 5. Backend — NestJS ile Mobil Uyum

### 5.1 Agora Token Endpoint

```typescript
// rooms.controller.ts
@Get(':id/agora-token')
@UseGuards(JwtAuthGuard)
async getAgoraToken(@Param('id') roomId: string, @CurrentUser() user: User) {
    return this.roomsService.generateAgoraToken(roomId, user.id);
}

// rooms.service.ts
async generateAgoraToken(roomId: string, userId: string) {
    const uid = parseInt(userId.replace(/-/g, '').slice(0, 8), 16); // deterministik UID
    const expireTime = Math.floor(Date.now() / 1000) + 3600; // 1 saat
    const token = RtcTokenBuilder.buildTokenWithUid(
        process.env.AGORA_APP_ID,
        process.env.AGORA_APP_CERTIFICATE,
        roomId,
        uid,
        RtcRole.PUBLISHER,
        expireTime
    );
    return { token, uid };
}
```

### 5.2 Q&A Endpoint'leri

```typescript
@Post('questions')
@UseGuards(JwtAuthGuard)
async createQuestion(@Body() dto: CreateQuestionDto, @CurrentUser() user: User) {
    const question = await this.qaService.createQuestion(dto, user.id);
    // Socket.io ile odadakilere bildir
    this.roomsGateway.emit(dto.roomId, 'question:new', question);
    return question;
}

@Post('questions/:id/vote')
@UseGuards(JwtAuthGuard)
async vote(@Param('id') questionId: string, @Body() dto: VoteDto, @CurrentUser() user: User) {
    const result = await this.qaService.vote(questionId, user.id, dto.direction);
    this.roomsGateway.emit(result.roomId, 'vote:updated', { questionId, count: result.count });
    return result;
}
```

### 5.3 Socket.io Events (Mobil)

```
Android Socket.io client: io.socket:socket.io-client:2.1.0
iOS Socket.io client: socket.io-client-swift

Ortak event isimleri:
  question:new     → Yeni soru geldi
  vote:updated     → Oy güncellendi
  camera:on        → Kullanıcı kamera açtı
  camera:off       → Kullanıcı kamera kapattı
  presence:update  → Odadaki kullanıcılar değişti
```

